# Laravel application env. Copy to .env (make env does it). Secrets stay empty or change_me.
# Container settings (ports, DB root password, vault) live in docker/.env, not here.

# --- App ---
APP_NAME=tron-cleanroom
APP_ENV=local
APP_DEBUG=false
# Leave APP_KEY empty: `make bootstrap` runs php artisan key:generate.
APP_KEY=
# Address the wallet listener can reach (it calls APP_URL/webhook/wallet-listener).
# Local, no domain: http://tron-cleanroom (shared docker network).
APP_URL=https://example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DASHBOARD_PREFIX=/admin
# API keys for the app's own HTTP API.
GLOBAL_OUR_API_KEY=
GLOBAL_READONLY_API_KEY=
# Basic auth in front of the log viewer (empty = locked).
LOG_VIEWER_ENABLED=true
LOG_VIEWER_ROUTE_PATH=/log-viewer
LOG_VIEWER_USERNAME=
LOG_VIEWER_PASSWORD=
LOG_VIEWER_PRODUCTION_TOKEN=
# Test seeder (TransactionAmlChecksSeeder).
SEED_CLEAR=false
SEED_TRANSACTION_LIMIT=10

# --- Database ---
# Same DB_DATABASE / DB_USERNAME / DB_PASSWORD as docker/.env.
DB_CONNECTION=mysql
DB_HOST=app-mysql
DB_PORT=3306
DB_DATABASE=tron_processing
DB_USERNAME=tron
DB_PASSWORD=change_me
# Optional DB for the wallet key backup (BackupWalletKeyJob).
WALLET_KEY_BACKUP_ENABLED=false
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_DATABASE=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# --- Redis / Queue / Cache / Session ---
REDIS_CLIENT=phpredis
REDIS_HOST=app-redis
REDIS_PORT=6379
# Same as REDIS_PASSWORD in docker/.env.
REDIS_PASSWORD=change_me
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- TRON ---
# Fallback nodes; the tron_nodes table is the source of truth once seeded.
TRON_FULL_NODE=
TRON_SOLIDITY_NODE=
TRON_EVENT_SERVER=
TRON_API_KEY=
TRON_2_FULL_NODE=
TRON_2_SOLIDITY_NODE=
TRON_2_EVENT_SERVER=
TRON_2_API_KEY=
TRONGRID_FULL_NODE=https://api.trongrid.io
TRONGRID_SOLIDITY_NODE=https://api.trongrid.io
TRONGRID_EVENT_SERVER=https://api.trongrid.io
TRONGRID_API_KEY=
# Other chains (block explorers).
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
SNOWTRACE_API_KEY=
BLOCKCYPHER_TOKEN=

# --- Wallet listener (cleanroom-watcher) ---
WALLET_LISTENER_SERVICE_URL=http://cleanroom-watcher:8080
# Listener API key, sent as X-API-Key (a value from listener api.api_keys).
WALLET_LISTENER_WEBHOOK_SECRET=
# Random secret that signs listener webhooks. Required: empty = every webhook is rejected.
WALLET_LISTENER_HMAC_SECRET=

# --- Encryptor / vault ---
# No variables here: enc/encryptor reads its KEK from enc/kek and its vault DSN from
# enc/config.json, both generated by `make bootstrap`. Vault password: DB_PASSWORD_KEY_STORAGE in docker/.env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook
TELEGRAM_CERTIFICATE_PATH=
TELEGRAM_ASYNC_REQUESTS=false
TELEGRAM_OPERATIONS_BOT_TOKEN=
TELEGRAM_OPERATIONS_CHAT_ID=
TELEGRAM_OPERATIONS_SECRET_TOKEN=
TELEGRAM_OPERATIONS_WEBHOOK_URL=https://example.com/telegram/operations/webhook

# --- AML providers (wired in AmlServiceDispatcher) ---
# AMLBot
AML_ACCESS_ID=
AML_ACCESS_KEY=
# Inbound AMLBot webhook path (default /aml/webhook). Use a hard-to-guess value in production
# and register APP_URL + this path at AMLBot. The signature is still checked with AML_ACCESS_KEY.
AML_WEBHOOK_PATH=
# Well Wallet
WELL_WALLET_BASE_URL=https://example.com/api
WELL_WALLET_API_KEY=
# GetBlock
AML_GETBLOCK_TOKEN=
# BitOK
AML_BITOK_KEY_ID=
AML_BITOK_SECRET_KEY=
# CoinKYT
AML_COINKYT_API_KEY=
AML_COINKYT_REPORT_LANGUAGE=en
AML_COINKYT_RISK_PROFILE_ID=270
# Comma-separated report recipients.
AML_COINKYT_RECIPIENTS=
# Recursive AML
RECURSIVE_AML_ENABLED=false
RECURSIVE_AML_URL=
RECURSIVE_AML_API_KEY=
# AML database export manifest source.
AML_EXPORT_SOURCE=tron-telegram-api

# --- Energy providers ---
REFEE_TOKEN=
TR_ENERGY_API_KEY=
NETTS_API_KEY=

# --- Ledger (optional) ---
# External accounts ledger: link recipient wallets to ledger accounts. Empty = integration off.
# Example: http://tally-bot:8080 (the ledger's API_PORT); token = the ledger's API_TOKEN (sent as X-API-KEY).
LEDGER_API_URL=
LEDGER_API_TOKEN=

# --- Optional AI usage tracking ---
OPENAI_API_KEY=
OPENAI_ADMIN_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
