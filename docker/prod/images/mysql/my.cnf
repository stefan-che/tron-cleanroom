[mysqld]
# --- Character sets ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# skip-character-set-client-handshake is not set: the option is deprecated
# in 8.0.35+ (warning MY-011069 in the log on every start), and it is not needed:
# Laravel sets the connection charset explicitly (DB_CHARSET=utf8mb4
# in config/database.php, PDO sends SET NAMES on connect).

# --- Network ---
# The container lives on the internal network; no port is published outside.
bind-address = 0.0.0.0
max_connections = 200
# Modern equivalent of skip-host-cache (that one comes from the image's /etc/my.cnf
# and triggers warning MY-011068 from there; overriding it would require
# replacing the image file, which is not worth it for log cosmetics).
host_cache_size = 0
max_allowed_packet = 64M
# Drop hung connections instead of accumulating them.
wait_timeout = 600
interactive_timeout = 600

# --- Security ---
# Forbid LOAD DATA LOCAL INFILE and file access via SQL.
local_infile = 0
secure_file_priv = /var/lib/mysql-files
skip_name_resolve = 1
# symbolic-links = 0 is omitted: it is the default since 8.0, and setting it
# explicitly prints a deprecation warning (MY-011070).

# --- InnoDB ---
# buffer_pool ~50-70% of the container memory limit (MYSQL_MEMORY=2G).
innodb_buffer_pool_size = 1G
# innodb_log_file_size / innodb_log_files_in_group are deprecated (MY-013907):
# the server converted them to redo_log_capacity anyway; now it is set directly.
innodb_redo_log_capacity = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# --- Binlog: required for PITR recovery ---
log_bin = mysql-bin
# binlog_format is not set: ROW is the default since 8.0, and setting it
# explicitly is deprecated (MY-011070).
binlog_expire_logs_seconds = 604800
max_binlog_size = 256M

# --- Logs ---
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 0
log_error_verbosity = 2

# --- Misc ---
default_time_zone = '+00:00'
sql_mode = "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
