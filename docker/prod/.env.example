# Production compose env. Copy to docker/prod/.env, chmod 600. Replace every change_me.
# Laravel secrets live in the app ../../.env, not here.

# --- Compose ---
COMPOSE_PROJECT_NAME=tron-prod
# Repo root, relative to this directory.
APP_PATH=../..
# UID/GID of the host user that owns vendor/, storage/, bootstrap/cache.
PUID=33
PGID=33
TZ=UTC

# --- Nginx ---
APP_DOMAIN=example.com
HTTP_PORT=80
CLIENT_MAX_BODY_SIZE=32m

# --- Database ---
# DB_DATABASE / DB_USERNAME / DB_PASSWORD must match the Laravel .env.
DB_DATABASE=tron_processing
DB_USERNAME=tron
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me
MYSQL_DATA_PATH=./data/mysql

# --- Redis ---
# Same as REDIS_PASSWORD in the Laravel .env.
REDIS_PASSWORD=change_me
REDIS_DATA_PATH=./data/redis

# --- PHP / opcache ---
PHP_MEMORY_LIMIT=512M
# 0 = no revalidation (reload code with `make deploy`); 1 = revalidate on change.
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0

# --- Queue workers ---
QUEUE_WORKERS=2
QUEUE_TRIES=3
QUEUE_TIMEOUT=300
QUEUE_MAX_JOBS=500
QUEUE_MAX_TIME=3600

# --- Resource limits ---
PHP_CPUS=2
PHP_MEMORY=2G
QUEUE_CPUS=2
QUEUE_MEMORY=1G
SCHEDULER_CPUS=1
SCHEDULER_MEMORY=512M
NGINX_CPUS=1
NGINX_MEMORY=256M
MYSQL_CPUS=2
MYSQL_MEMORY=2G
REDIS_CPUS=1
REDIS_MEMORY=512M
