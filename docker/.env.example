# Dev docker compose env (container settings). Copy to docker/.env (make env does it).
# Required by `make bootstrap` (must be non-empty): DB_DATABASE, DB_USERNAME, DB_PASSWORD,
# DB_ROOT_PASSWORD, DB_PASSWORD_KEY_STORAGE, REDIS_PASSWORD. Replace every change_me.

# --- Database ---
# DB_DATABASE / DB_USERNAME / DB_PASSWORD must match the Laravel ../.env.
DB_DATABASE=tron_processing
DB_USERNAME=tron
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me
# Vault (encryptor) password for user enc_user. No ' or \ characters.
DB_PASSWORD_KEY_STORAGE=change_me

# --- Redis ---
# Same as REDIS_PASSWORD in the Laravel ../.env.
REDIS_PASSWORD=change_me

# --- Encryptor ---
# Path to the cleanroom-vault checkout (needs main.go and db.sql).
ENCRYPTOR_SRC=../../cleanroom-vault

# --- Docker ports / network ---
ENVIRONMENT=local
HTTP_PORT=80
HTTPS_PORT=443
# Bound to 127.0.0.1 only.
MYSQL_PUBLISH_PORT=3306
MYSQL_KS_PUBLISH_PORT=3307
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6380
# External network shared with cleanroom-watcher (created by `make network`).
SHARED_NETWORK=processing-net
