{
    "name": "stefan-che/tron-cleanroom",
    "type": "project",
    "description": "Self-hosted crypto hygiene for incoming USDT on TRON: a transit wallet per payment, AML screening, sweep to clean wallets.",
    "keywords": ["tron", "usdt", "aml", "crypto", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/web3.php",
            "options": {
                "symlink": false,
                "versions": {
                    "iexbase/web3.php": "2.0.1"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/comely-data-types",
            "options": {
                "symlink": false,
                "versions": {
                    "comely-io/data-types": "1.0.34"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "iexbase/tron-api": "^5.0",
        "irazasyed/telegram-bot-sdk": "^3.14",
        "laravel/framework": "^11.9",
        "laravel/tinker": "^2.9",
        "orchid/platform": "^14.31",
        "bacon/bacon-qr-code": "^2.0.8",
        "pragmarx/google2fa-laravel": "^2.1",
        "orchid/icons": "^2.2.1",
        "opcodesio/log-viewer": "^3.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
